# NASA API Key
NASA_API_KEY=

# N2YO API Key
N2YO_API_KEY=

# Telegram Bot Token
BOT_TOKEN=

# Optional: run the bot via webhook instead of polling. Set WEBHOOK_URL to
# your site's public HTTPS base (no trailing slash, e.g.
# https://neowatch.example.com) once it's behind a domain + TLS; leave unset
# to keep polling (default, no public URL needed). WEBHOOK_SECRET is
# Telegram's secret_token, checked on every POST /webhook/telegram — generate
# with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_URL=
WEBHOOK_SECRET=

# Default location (Kyiv, Ukraine - can be changed for user)
DEFAULT_LAT=
DEFAULT_LON=
DEFAULT_ALT=

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Geoapify API Key (for maps)
GEOAPIFY_KEY=

# Feedback form (footer modal → POST /api/feedback → bot forwards to this
# Telegram chat). The recipient must have started the bot first. Reuses
# BOT_TOKEN; without it the endpoint returns 503 ("service unavailable").
FEEDBACK_CHAT_ID=372391903

# NASA GCN Kafka client (gravitational-wave alerts — services/gw_alerts.py).
# Free: sign in at https://gcn.nasa.gov, open "Client Credentials", create a
# new client with Kafka access. Without these, GW alerts are simply disabled.
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=
