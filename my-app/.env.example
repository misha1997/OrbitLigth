# CARTO basemap API key (free tier) — required so the Leaflet map tiles
# (SatMap/DarkSkyMap/EarthTerminatorMap) don't get the "API KEY REQUIRED"
# watermark. Get one at https://carto.com/basemaps/apikey/
# Baked into the bundle at build time (npm run build) — CRA only reads
# REACT_APP_* vars, and only at build, not at runtime.
REACT_APP_CARTO_KEY=
